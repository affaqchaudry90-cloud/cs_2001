' ---------- inheritance (is a) ----------
Account <|-- CurrentAccount
Account <|-- SavingsAccount
InterestBearing <|-- SavingsAccount
SavingsAccount <|-- YouthSavingsAccount
Account <|-- LoanAccount
Transaction <|-- Deposit
Transaction <|-- Withdrawal
Transaction <|-- Transfer
Transaction <|-- FeeCharge
Transaction <|-- InterestCredit
CustomerAgent <|-- SalariedAgent
CustomerAgent <|-- StudentAgent
CustomerAgent <|-- MerchantAgent
CustomerAgent <|-- FraudsterAgent
Rule <|-- VelocityRule
Rule <|-- LargeAmountRule
Rule <|-- RoundTripRule
Exception <|-- LedgerError
LedgerError <|-- AccountError
AccountError <|-- InsufficientFundsError
AccountError <|-- FrozenAccountError
AccountError <|-- UnknownAccountError
AccountError <|-- WithdrawalLimitError
LedgerError <|-- TransactionError
TransactionError <|-- NegativeAmountError
TransactionError <|-- RollbackError
LedgerError <|-- FraudError
FraudError <|-- SuspiciousActivityError
LedgerError <|-- ConfigError
LedgerError <|-- EmptyQueueError
LedgerError <|-- EmptyStackError

' ---------- realization (implements interface) ----------
Reportable <|.. Statement
Reportable <|.. AuditReport

' ---------- composition (owns) ----------
Bank "1" *-- "0..*" Account
Bank "1" *-- "1..*" Branch
Bank "1" *-- "1" TransactionLog
Bank "1" *-- "1" UndoStack
Simulation "1" *-- "1" Bank
Simulation "1" *-- "1" FraudMonitor
Simulation "1" *-- "1" PaymentQueue
FraudMonitor "1" *-- "1..*" Rule

' ---------- aggregation (has) ----------
Customer "1..*" o-- "0..*" Account : holds\n(joint = many-to-many)
Bank "1" o-- "0..*" Customer
Simulation "1" o-- "1..*" CustomerAgent
Simulation "1" o-- "0..*" ScheduledPayment : standing orders
TransactionLog "1" o-- "0..*" Transaction
PaymentQueue "1" o-- "0..*" ScheduledPayment
UndoStack "1" o-- "0..*" Transaction

' ---------- association (knows) ----------
Customer "0..*" --> "1" Branch : home branch
CustomerAgent "1" --> "1" Customer : acts for
Statement "0..*" --> "1" Account : describes
AuditReport "1" --> "1" Bank : audits
AuditReport "1" --> "1" FraudMonitor : reads

' ---------- dependency (uses / creates) ----------
CustomerAgent ..> Transaction : <<creates>>
Transaction ..> Bank : <<applied to>>
TransactionLog ..> LogIterator : <<creates>>
Simulation ..> CustomerSpec : <<reads>>
Simulation ..> AuditReport : <<creates>>

legend right
  |= Symbol |= Meaning |
  | <&#124;-- | is a (inherits; triangle at parent) |
  | <&#124;.. | implements interface (realization) |
  | *-- | owns (composition; filled diamond) |
  | o-- | has (aggregation; hollow diamond) |
  | --> | knows (association) |
  | ..> | uses / creates (dependency) |
  | + / - | public / private |
  | //italic// | abstract |
  | __underline__ | class attribute |
  |<#DBEAFE> blue | Chaudry Affaq Ur Rehman (29020161) |
  |<#FEF3C7> amber | Ahmed Mohammad Iqbal (28020022) |
  |<#D1FAE5> green | shared |
  |<#FEE2E2> red | exceptions |
endlegend

