package "ledger/scheduler.py" {
  class ScheduledPayment <<frozen dataclass>> #FEF3C7 {
    + from_iban: str
    + to_iban: str
    + amount: Money
    + due_day: int
    + attempts: int = 0
    --
    + with_penalty(penalty: Money) : ScheduledPayment
  }
  class PaymentQueue <<ADT · Queue (FIFO)>> #FEF3C7 {
    - _items: list[ScheduledPayment]
    - _front: int
    --
    + enqueue(payment: ScheduledPayment) : None  «O(1)»
    + dequeue() : ScheduledPayment  «O(1)»
    + peek() : ScheduledPayment  «O(1)»
    + is_empty() : bool  «O(1)»
    + __len__() : int  «O(1)»
    + __repr__() : str
  }
  class UndoStack <<ADT · Stack (LIFO)>> #FEF3C7 {
    - _items: list[Transaction]
    --
    + push(tx: Transaction) : None  «O(1)»
    + pop() : Transaction  «O(1)»
    + peek() : Transaction  «O(1)»
    + is_empty() : bool  «O(1)»
    + __len__() : int  «O(1)»
    + __repr__() : str
  }
}

