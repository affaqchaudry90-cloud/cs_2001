@startuml LEDGER
set namespaceSeparator none
left to right direction
' CS 2001 Course Project - Idea 3: LEDGER  (UML v5 - synced 1-to-1 with final code)
' Stretch goals: (1) joint accounts  (2) interest back-dating via recursion
'                (3) both PaymentQueue and UndoStack
' Blue = Chaudry Affaq Ur Rehman (29020161), Amber = Ahmed Mohammad Iqbal (28020022)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classFontStyle bold
skinparam defaultFontName DejaVu Sans
skinparam classBorderColor #374151
skinparam ArrowColor #374151
hide circle
hide empty members

title LEDGER - UML Class Diagram v5 (CS 2001 Fall 2026)

package "ledger/money.py" {
  class Money <<frozen dataclass, total_ordering>> #DBEAFE {
    + paisa: int
    --
    {static} + from_rupees(rupees: float) : Money  «classmethod»
    + __add__(other: Money) : Money
    + __sub__(other: Money) : Money
    + __mul__(factor: float) : Money
    + __lt__(other: Money) : bool
    + __eq__(other: object) : bool  «auto»
    + __hash__() : int  «auto»
    + __str__() : str
    + __repr__() : str  «auto»
    - __post_init__() : None
  }
}

package "ledger/accounts.py" {
  class InterestBearing <<mixin>> #DBEAFE {
    {static} + RATE: float = 0.0
    --
    + annual_rate: float  «property»
    + daily_interest() : Money  «overrides Account»
    + backdated_interest(days: int) : Money  «overrides Account»
    - _compound(paisa: int, days: int) : int  «recursive»
  }
  abstract class Account #DBEAFE {
    - _iban: str
    - _holder_ids: list[str]
    - _balance: Money
    - _frozen: bool
    - _frozen_reason: str
    --
    + __init__(iban: str, holder_id: str)
    + iban: str  «property»
    + holders: tuple[str, ...]  «property»
    + balance: Money  «property»
    + is_frozen: bool  «property»
    + frozen_reason: str  «property»
    + add_holder(customer_id: str) : None
    + is_joint() : bool
    + deposit(amount: Money) : None
    + withdraw(amount: Money) : None
    + freeze(reason: str) : None
    + daily_interest() : Money  «Money(0)»
    + backdated_interest(days: int) : Money  «Money(0)»
    {abstract} + can_withdraw(amount: Money) : bool
    {abstract} + monthly_fee() : Money
    + __eq__(other: object) : bool  «by IBAN»
    + __hash__() : int  «by IBAN»
    + __lt__(other: Account) : bool  «by balance»
    + __repr__() : str
  }
  class CurrentAccount #DBEAFE {
    {static} + FEE: Money = Rs 150
    --
    + can_withdraw(amount: Money) : bool
    + monthly_fee() : Money
  }
  class SavingsAccount #DBEAFE {
    {static} + RATE: float = 0.08
    {static} + MIN_BALANCE: Money = Rs 500
    --
    + can_withdraw(amount: Money) : bool
    + monthly_fee() : Money
  }
  class YouthSavingsAccount #DBEAFE {
    {static} + RATE: float = 0.10
    {static} + MIN_BALANCE: Money = Rs 0
    {static} + MAX_WITHDRAWAL: Money = Rs 5,000
    --
    + can_withdraw(amount: Money) : bool
    + withdraw(amount: Money) : None
  }
  class LoanAccount #DBEAFE {
    - _principal: Money
    - _instalment: Money
    --
    + __init__(iban: str, holder_id: str, principal: Money, instalment: Money)
    + principal: Money  «property»
    + instalment: Money  «property»
    + remaining() : Money
    + is_paid_off() : bool
    + deposit(amount: Money) : None
    + can_withdraw(amount: Money) : bool
    + monthly_fee() : Money
  }

  note bottom of SavingsAccount
    class SavingsAccount(InterestBearing, Account)
    MRO: SavingsAccount → InterestBearing → Account → ABC → object
  end note
}

package "ledger/bank.py" {
  class Bank #DBEAFE {
    - _name: str
    - _accounts: dict[str, Account]
    - _customers: dict[str, Customer]
    - _branches: dict[str, Branch]
    - _log: TransactionLog
    - _undo: UndoStack
    - _next_account: int
    - _next_tx: int
    - _opening_deposits: Money
    - _transfers_tried: int
    - _transfers_done: int
    - _rollbacks: int
    --
    + __init__(name: str)
    + open_branch(code: str, city: str) : Branch
    + add_customer(customer: Customer) : None
    + open_account(holders: list[Customer], kind: str, opening: Money) : Account  «joint if 2+ holders»
    + open_loan(customer: Customer, principal: Money, instalment: Money) : LoanAccount
    + next_tx_id() : int
    + transfer(from_iban: str, to_iban: str, amount: Money, count_stats: bool = True) : None  «atomic»
    + execute(tx: Transaction) : bool
    + rollback_last() : Transaction
    + backdate_interest(iban: str, from_day: int, today: int) : InterestCredit | None
    + freeze(iban: str, reason: str) : None
    + log: TransactionLog  «property»
    + opening_deposits: Money  «property»
    + transfer_counts() : tuple[int, int, int]  «tried, done, rolled back»
    + customers() : list[Customer]
    + __getitem__(iban: str) : Account
    + __contains__(iban: str) : bool
    + __len__() : int
    + __iter__() : Iterator[Account]
    + __repr__() : str
  }
  class Customer #DBEAFE {
    - _customer_id: str
    - _name: str
    - _branch: Branch
    - _accounts: list[Account]
    --
    + __init__(customer_id: str, name: str, branch: Branch)
    + customer_id: str  «property»
    + name: str  «property»
    + branch: Branch  «property»
    + add_account(account: Account) : None
    + accounts() : list[Account]  «copy»
    + joint_accounts() : list[Account]
    + net_worth() : Money
    + __len__() : int
    + __repr__() : str
  }
  class Branch #DBEAFE {
    - _code: str
    - _city: str
    --
    + __init__(code: str, city: str)
    + code: str  «property»
    + city: str  «property»
    + __repr__() : str
  }
}

