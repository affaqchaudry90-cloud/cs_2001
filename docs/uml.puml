  class TransactionLog #FEF3C7 {
    - _entries: list[Transaction]
    - _rejected: list[tuple[Transaction, str]]
    - _reversed: list[Transaction]
    --
    + append(tx: Transaction) : None
    + reject(tx: Transaction, reason: str) : None
